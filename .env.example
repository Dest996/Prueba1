HOST=127.0.0.1
PORT=3000
# Importación inicial del administrador; después las cuentas se gestionan en AL DÍA.
# Si está vacío, la instalación local pide el código de la terminal.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Activa en un dashboard servido exclusivamente por HTTPS (incluido un proxy TLS).
SESSION_COOKIE_SECURE=0
# Proveedor: openai o gemini.
AI_PROVIDER=openai
GEMINI_API_KEY=
# Vacío: descubre un modelo Flash Lite/Flash estable disponible; verifica su cuota en AI Studio.
GEMINI_MODEL=
# En Windows: npm run configurar guarda esta clave sin mostrarla.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Configure these in Meta's WhatsApp Business app for real incoming messages.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# Required: your personal sender number (country code, no +).
WHATSAPP_ALLOWED_FROM=
WHATSAPP_PHONE_NUMBER_ID=
# Optional separate loopback listener for a public HTTPS tunnel (set by the wizard).
WHATSAPP_WEBHOOK_PORT=
WHATSAPP_GRAPH_VERSION=v23.0
TIMEZONE=America/Santiago
